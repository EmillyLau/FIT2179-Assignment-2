{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Malaysia’s Rainfall and Temperature Trend (2000–2021)",
    "subtitle": "Rainfall and maximum temperature are averaged across available stations by year"
  },
  "data": {
    "url": "../data/rainfall.csv"
  },
  "transform": [
    {
      "aggregate": [
        {"op": "mean", "field": "rainfall_mm", "as": "avg_rainfall"},
        {"op": "mean", "field": "max_temperature_celcius", "as": "avg_max_temp"}
      ],
      "groupby": ["year"]
    },
    {"calculate": "toNumber(datum.year)", "as": "year_num"},
    {"calculate": "toNumber(datum.avg_rainfall)", "as": "avg_rainfall_num"},
    {"calculate": "toNumber(datum.avg_max_temp)", "as": "avg_max_temp_num"}
  ],
  "vconcat": [
    {
      "width": 800,
      "height": 220,
      "mark": {
        "type": "area",
        "opacity": 0.35,
        "color": "#4a90d9",
        "line": {
          "color": "#2563eb",
          "strokeWidth": 2.5
        }
      },
      "encoding": {
        "x": {
          "field": "year_num",
          "type": "quantitative",
          "title": null,
          "axis": {
            "format": "d",
            "labels": false,
            "ticks": false
          }
        },
        "y": {
          "field": "avg_rainfall_num",
          "type": "quantitative",
          "title": "Avg Rainfall (mm)",
          "scale": {"zero": false}
        },
        "tooltip": [
          {"field": "year_num", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "avg_rainfall_num", "type": "quantitative", "title": "Avg Rainfall (mm)", "format": ".1f"}
        ]
      }
    },
    {
      "width": 800,
      "height": 220,
      "mark": {
        "type": "line",
        "color": "#e8512a",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "size": 55,
          "color": "#e8512a"
        }
      },
      "encoding": {
        "x": {
          "field": "year_num",
          "type": "quantitative",
          "title": "Year",
          "axis": {
            "format": "d"
          }
        },
        "y": {
          "field": "avg_max_temp_num",
          "type": "quantitative",
          "title": "Avg Max Temp (°C)"
        },
        "tooltip": [
          {"field": "year_num", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "avg_max_temp_num", "type": "quantitative", "title": "Avg Max Temp (°C)", "format": ".1f"}
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Flood Loss per Living Quarter by Malaysian State (2024–2025)",
  "width": 800,
  "height": 450,

  "data": {
    "url": "../data/malaysia_states.topojson",
    "format": {
      "type": "topojson",
      "feature": "states"
    }
  },

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "transform": [
        {
          "calculate": "'Data is not available for ' + datum.properties.Name",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      },
      "encoding": {
        "tooltip": {
          "field": "note"
        }
      }
    },

    {
      "transform": [
        {
          "lookup": "properties.Name",
          "from": {
            "data": {
              "url": "../data/flood_impacts.csv"
            },
            "key": "state",
            "fields": [
              "living_quarters_total",
              "total_loss_2024",
              "total_loss_2025",
              "total_loss_combined"
            ]
          }
        },
        {
          "calculate":
          "(datum.total_loss_combined / datum.living_quarters_total)",
          "as": "loss_per_living_quarter"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {
        "color": {
          "field": "loss_per_living_quarter",
          "type": "quantitative",
          "title": "Loss per Living Quarter (RM)",
         "scale": {
          "type": "threshold",
          "domain": [50, 200, 400, 800],
          "range": [
            "#eff3ff",
            "#8ec1e6",
            "#4f97c9",
            "#08519c",
            "#08306b"
          ]
        }
        },

        "tooltip": [
          {
            "field": "properties.Name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "loss_per_living_quarter",
            "type": "quantitative",
            "title": "Loss per Living Quarter (RM)",
            "format": ",.2f"
          },
          {
            "field": "living_quarters_total",
            "type": "quantitative",
            "title": "Total Living Quarters",
            "format": ","
          },
          {
            "field": "total_loss_combined",
            "type": "quantitative",
            "title": "Total Loss 2024–2025 (RM)",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {}
}

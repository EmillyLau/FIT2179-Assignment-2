{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Timeline of Major Flood Events in Malaysia (2011–2025)",
    "subtitle": "Each bar shows the start and end date of a flood event",
    "subtitleFontSize": 11
  },
  "width": 800,
  "height": 450,
  "data": {"url": "../data/flood_emdat.csv"},
  "transform": [
    {
      "calculate": "datetime(datum.start_year, datum.start_month - 1, datum.start_day)",
      "as": "start_date"
    },
    {
      "calculate": "datetime(datum.end_year, datum.end_month - 1, datum.end_day)",
      "as": "end_date"
    },
    {
      "calculate": "toNumber(datum.flood_duration)",
      "as": "duration_days"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadius": 3
  },
  "encoding": {
    "y": {
      "field": "disaster_no",
      "type": "nominal",
      "title": "Event ID",
      "sort": {"field": "start_date", "order": "descending"},
      "axis": {"labelFontSize": 9}
    },
    "x": {
      "field": "start_date",
      "type": "temporal",
      "title": "Timeline",
      "axis": {"format": "%b %Y", "labelAngle": -30}
    },
    "x2": {"field": "end_date"},
    "color": {
      "field": "disaster_subtype",
      "type": "nominal",
      "title": "Flood Type",
      "scale": {
        "domain": ["Flood (General)", "Flash flood", "Riverine flood"],
        "range": ["#e8512a", "#f5a623", "#08519c"]
      }
    },
    "tooltip": [
      {"field": "disaster_no", "type": "nominal", "title": "Event ID"},
      {"field": "disaster_subtype", "type": "nominal", "title": "Flood Type"},
      {"field": "location", "type": "nominal", "title": "Location"},
      {"field": "start_date", "type": "temporal", "title": "Start Date", "format": "%b %d, %Y"},
      {"field": "end_date", "type": "temporal", "title": "End Date", "format": "%b %d, %Y"},
      {"field": "flood_duration", "type": "quantitative", "title": "Duration (days)"},
      {"field": "total_affected", "type": "quantitative", "title": "Total Affected", "format": ","},
      {"field": "total_deaths", "type": "quantitative", "title": "Deaths", "format": ","}
    ]
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Rainfall Variability and Rising Heat in Malaysia (2000–2021)",
    "subtitle": "Annual averages across all weather stations nationally. Drag the overview chart to filter years.",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "anchor": "middle"
  },
  "data": {"url": "/FIT2179-Assignment-2/data/rainfall.csv"},
  "transform": [
    {
      "aggregate": [
        {"op": "mean", "field": "rainfall_mm", "as": "avg_rainfall"},
        {"op": "mean", "field": "max_temperature_celcius", "as": "avg_temp"},
        {"op": "mean", "field": "rainy_days", "as": "avg_rainy_days"}
      ],
      "groupby": ["year"]
    },
    {"calculate": "toNumber(datum.year)", "as": "year_num"},
    {"calculate": "toNumber(datum.avg_rainfall)", "as": "avg_rainfall_num"},
    {"calculate": "toNumber(datum.avg_temp)", "as": "avg_temp_num"}
  ],
  "vconcat": [
    {
      "width": 800,
      "height": 200,
      "title": "Average Annual Rainfall",
      "transform": [
        {"filter": {"param": "time_brush"}}
      ],
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#2b6cb0",
            "strokeWidth": 2.5,
            "point": {
              "filled": true,
              "color": "#2b6cb0",
              "size": 50
            }
          },
          "encoding": {
            "x": {
              "field": "year_num",
              "type": "quantitative",
              "axis": {
                "format": "d",
                "tickMinStep": 1,
                "title": null,
                "labels": false,
                "ticks": false,
                "grid": false
              }
            },
            "y": {
              "field": "avg_rainfall_num",
              "type": "quantitative",
              "title": "Average Rainfall (mm)",
              "scale": {"zero": false},
              "axis": {
                "titleColor": "#4a90d9",
                "labelColor": "#4a90d9",
                "grid": false
              }
            },
            "tooltip": [
              {"field": "year_num", "type": "quantitative", "title": "Year", "format": "d"},
              {"field": "avg_rainfall_num", "type": "quantitative", "title": "Avg Rainfall (mm)", "format": ".1f"},
              {"field": "avg_rainy_days", "type": "quantitative", "title": "Avg Rainy Days", "format": ".1f"}
            ]
          }
        },
        {
          "mark": {
            "type": "line",
            "color": "#1a5fa8",
            "strokeDash": [6, 3],
            "strokeWidth": 1.2
          },
          "transform": [
            {"regression": "avg_rainfall_num", "on": "year_num"}
          ],
          "encoding": {
            "x": {"field": "year_num", "type": "quantitative"},
            "y": {"field": "avg_rainfall_num", "type": "quantitative"}
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#888",
            "strokeDash": [4, 4],
            "strokeWidth": 1
          },
          "transform": [
            {"filter": "datum.year_num == 2014 || datum.year_num == 2021"}
          ],
          "encoding": {
            "x": {"field": "year_num", "type": "quantitative"}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -5,
            "y": 10,
            "fontSize": 11,
            "color": "#555",
            "fontWeight": "bold"
          },
          "transform": [
            {"filter": "datum.year_num == 2014 || datum.year_num == 2021"}
          ],
          "encoding": {
            "x": {"field": "year_num", "type": "quantitative"},
            "text": {
              "condition": {
                "test": "datum.year_num == 2014",
                "value": "2014 floods"
              },
              "value": "2021 floods"
            }
          }
        }
      ]
    },
    {
      "width": 800,
      "height": 200,
      "title": "Average Maximum Temperature",
      "transform": [
        {"filter": {"param": "time_brush"}}
      ],
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#d95f02",
            "strokeWidth": 2.5,
            "point": {
              "filled": true,
              "size": 50,
              "color": "#d95f02"
            }
          },
          "encoding": {
            "x": {
              "field": "year_num",
              "type": "quantitative",
              "title": "Year",
              "axis": {
                "format": "d",
                "tickMinStep": 1,
                "grid": false
              }
            },
            "y": {
              "field": "avg_temp_num",
              "type": "quantitative",
              "title": "Avg Max Temperature (°C)",
              "scale": {"zero": false},
              "axis": {
                "titleColor": "#d95f02",
                "labelColor": "#d95f02",
                "grid": false
              }
            },
            "tooltip": [
              {"field": "year_num", "type": "quantitative", "title": "Year", "format": "d"},
              {"field": "avg_temp_num", "type": "quantitative", "title": "Avg Max Temp (°C)", "format": ".2f"}
            ]
          }
        },
        {
          "mark": {
            "type": "line",
            "color": "#a83000",
            "strokeDash": [6, 3],
            "strokeWidth": 1.2
          },
          "transform": [
            {"regression": "avg_temp_num", "on": "year_num"}
          ],
          "encoding": {
            "x": {"field": "year_num", "type": "quantitative"},
            "y": {"field": "avg_temp_num", "type": "quantitative"}
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#888",
            "strokeDash": [4, 4],
            "strokeWidth": 1
          },
          "transform": [
            {"filter": "datum.year_num == 2014 || datum.year_num == 2021"}
          ],
          "encoding": {
            "x": {"field": "year_num", "type": "quantitative"}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -5,
            "y": 10,
            "fontSize": 11,
            "color": "#555",
            "fontWeight": "bold"
          },
          "transform": [
            {"filter": "datum.year_num == 2014 || datum.year_num == 2021"}
          ],
          "encoding": {
            "x": {"field": "year_num", "type": "quantitative"},
            "text": {
              "condition": {
                "test": "datum.year_num == 2014",
                "value": "2014 floods"
              },
              "value": "2021 floods"
            }
          }
        }
      ]
    },
    {
      "width": 800,
      "height": 60,
      "title": {
      "text": "Brush uses rainfall as the overview; selected years filter both charts",
      "fontSize": 12,
      "anchor": "middle"
    },
      "params": [
        {
          "name": "time_brush",
          "select": {
            "type": "interval",
            "encodings": ["x"]
          }
        }
      ],
      "mark": {
        "type": "area",
        "color": "#94a3b8",
        "opacity": 0.65
      },
      "encoding": {
        "x": {
          "field": "year_num",
          "type": "quantitative",
          "axis": {
            "format": "d",
            "tickMinStep": 1,
            "title": null,
            "grid": false
          }
        },
        "y": {
          "field": "avg_rainfall_num",
          "type": "quantitative",
          "title": null,
          "axis": {
            "labels": false,
            "ticks": false,
            "domain": false,
            "grid": false
          }
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "padding": {
      "top": 8,
      "bottom": 8,
      "left": 8,
      "right": 8
    },
    "title": {
      "offset": 15,
      "fontSize": 17,
      "subtitleFontSize": 12,
      "anchor": "middle"
    },
    "axis": {
      "grid": false,
      "domainColor": "#cbd5e1",
      "tickColor": "#cbd5e1",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#334155",
      "titleColor": "#334155"
    }
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Flood Economic Losses by State (2024–2025)",
    "subtitle": "Click a state on the lollipop chart to inspect its multi-year sector damage profile.",
    "subtitleFontSize": 11,
    "anchor": "middle"
  },
  "hconcat": [
    {
      "title": "Total Flood Losses by State",
      "data": {"url": "../data/flood_impacts.csv"},
      "width": 380,
      "height": 430,
      "transform": [
        {
          "calculate": "toNumber(datum.total_loss_combined) / 1000000",
          "as": "loss_millions"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeWidth": 2
          },
          "encoding": {
            "y": {
              "field": "state",
              "type": "nominal",
              "title": "State",
              "sort": {"field": "loss_millions", "order": "descending"}
            },
            "x": {
              "field": "loss_millions",
              "type": "quantitative",
              "title": "Total Flood Losses (RM million)"
            },
            "x2": {"datum": 0},
            "color": {
              "field": "loss_millions",
              "type": "quantitative",
              "scale": {
                "domain": [0, 350],
                "range": ["#fdba74", "#f97316", "#991b1b"]
              },
              "legend": null
            },
                        "opacity": {
              "condition": {"param": "state_select", "value": 1},
              "value": 0.25
            }
          }
        },
        {
          "params": [
            {
              "name": "state_select",
              "select": {
                "type": "point",
                "fields": ["state"],
                "toggle": false
              }
            }
          ],
          "mark": {
            "type": "circle",
            "size": 140,
            "stroke": "white",
            "strokeWidth": 1.5
          },
          "encoding": {
            "y": {
              "field": "state",
              "type": "nominal",
              "sort": {"field": "loss_millions", "order": "descending"}
            },
            "x": {
              "field": "loss_millions",
              "type": "quantitative",
              "axis": {"format": ".0f"}
            },
            "color": {
              "field": "loss_millions",
              "type": "quantitative",
              "scale": {
                "domain": [0, 350],
                "range": ["#fdba74", "#f97316", "#991b1b"]
              }
            },
              "opacity": {
              "condition": {"param": "state_select", "value": 1},
              "value": 0.25
            },
            "tooltip": [
              {"field": "state", "type": "nominal", "title": "State"},
              {"field": "loss_millions", "type": "quantitative", "title": "Total Loss (RM million)", "format": ".1f"},
              {"field": "total_loss_2024", "type": "quantitative", "title": "2024 Loss (RM)", "format": ","},
              {"field": "total_loss_2025", "type": "quantitative", "title": "2025 Loss (RM)", "format": ","}
            ]
          }
        }
      ]
    },
    {
      "title": "Sector Loss Breakdown Comparison",
      "data": {"url": "../data/flood_impacts_long.csv"},
      "width": 380,
      "height": 430,
      "transform": [
        {
          "filter": {"param": "state_select"}
        },
        {
          "calculate": "toNumber(datum.amount_losses) / 1000000",
          "as": "amount_millions"
        },
        {
          "calculate": "toString(datum.year)",
          "as": "year_str"
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "category",
          "type": "nominal",
          "title": "Sector Category",
          "sort": "-x"
        },
        "yOffset": {
          "field": "year_str"
        },
        "x": {
          "field": "amount_millions",
          "type": "quantitative",
          "title": "Loss (RM million)",
          "axis": {"format": ".0f"}
        },
        "color": {
        "field": "year_str",
        "type": "nominal",
        "title": "Year",
        "legend": {
          "orient": "top"
        },
        "scale": {
          "domain": ["2024", "2025"],
          "range": ["#1d4ed8", "#60a5fa"]
        }
      },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "category", "type": "nominal", "title": "Sector"},
          {"field": "year_str", "type": "nominal", "title": "Year"},
          {"field": "amount_millions", "type": "quantitative", "title": "Loss (RM M)", "format": ".2f"}
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },

    "axisX": {
      "grid": true,
      "gridColor": "#e2e8f0",
      "gridOpacity": 0.7,
      "domain": true,
      "domainColor": "#cbd5e1",
      "tickColor": "#cbd5e1"
    },

    "axisY": {
      "grid": false,
      "domain": false,
      "ticks": false
    },
  "padding": {"top": 20, "bottom": 20, "left": 20, "right": 20},
    "title": {
      "offset": 15,
      "fontSize": 14,
      "subtitleFontSize": 11,
      "anchor": "start"
    }
  }
}
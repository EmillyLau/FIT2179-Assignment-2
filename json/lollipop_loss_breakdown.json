{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Flood Economic Losses by State (2024–2025)",
    "subtitle": "Economic losses reveal how flood damage spreads across homes, infrastructure, agriculture, and business activity.",
    "fontSize": 20,
    "subtitleFontSize": 14,
    "anchor": "middle"
  },
  "params": [
    {
      "name": "breakdown_year_filter",
      "value": "Both",
      "bind": {
        "input": "select",
        "options": ["Both", "2024", "2025"],
        "name": "Breakdown year: "
      }
    }
  ],
  "hconcat": [
    {
      "title": "Total Flood Losses by State",
      "data": {"url": "/FIT2179-Assignment-2/data/flood_impacts.csv"},
      "width": 420,
      "height": 430,
      "transform": [
        {
          "calculate": "toNumber(datum.total_loss_combined) / 1000000",
          "as": "loss_millions"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeWidth": 2
          },
          "encoding": {
            "y": {
              "field": "state",
              "type": "nominal",
              "title": null,
              "sort": {"field": "loss_millions", "order": "descending"}
            },
            "x": {
              "field": "loss_millions",
              "type": "quantitative",
              "title": "Total Flood Losses (RM million)",
              "scale": {"domain": [0, 390]}
            },
            "x2": {"datum": 0},
            "color": {
              "field": "loss_millions",
              "type": "quantitative",
              "scale": {
                "domain": [0, 350],
                "range": ["#fdba74", "#f97316", "#991b1b"]
              },
              "legend": null
            },
            "opacity": {
              "condition": {"param": "donut_state_pick_v3", "value": 1},
              "value": 0.25
            }
          }
        },
        {
          "params": [
            {
              "name": "donut_state_pick_v3",
              "select": {
                "type": "point",
                "fields": ["state"],
                "toggle": false
              }
            }
          ],
          "mark": {
            "type": "circle",
            "size": 140,
            "stroke": "white",
            "strokeWidth": 0.8
          },
          "encoding": {
            "y": {
              "field": "state",
              "type": "nominal",
              "sort": {"field": "loss_millions", "order": "descending"}
            },
            "x": {
              "field": "loss_millions",
              "type": "quantitative",
              "scale": {"domain": [0, 390]},
              "axis": {"format": ".0f"}
            },
            "color": {
              "field": "loss_millions",
              "type": "quantitative",
              "scale": {
                "domain": [0, 350],
                "range": ["#fdba74", "#f97316", "#991b1b"]
              }
            },
            "opacity": {
              "condition": {"param": "donut_state_pick_v3", "value": 1},
              "value": 0.25
            },
            "tooltip": [
              {"field": "state", "type": "nominal", "title": "State"},
              {"field": "loss_millions", "type": "quantitative", "title": "Total Loss (RM million)", "format": ".1f"},
              {"field": "total_loss_2024", "type": "quantitative", "title": "2024 Loss (RM)", "format": ","},
              {"field": "total_loss_2025", "type": "quantitative", "title": "2025 Loss (RM)", "format": ","}
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.state == 'Kelantan' || datum.state == 'Terengganu' || datum.state == 'Kedah'"
            },
            {
              "calculate": "datum.state == 'Kelantan' ? '352M' : datum.state == 'Terengganu' ? '271M' : '230M'",
              "as": "top_label"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 9,
            "fontSize": 14,
            "fontWeight": "bold",
            "color": "#7f1d1d"
          },
          "encoding": {
            "y": {
              "field": "state",
              "type": "nominal",
              "sort": {"field": "loss_millions", "order": "descending"}
            },
            "x": {
              "field": "loss_millions",
              "type": "quantitative",
              "scale": {"domain": [0, 390]}
            },
            "text": {"field": "top_label", "type": "nominal"},
            "opacity": {
              "condition": {"param": "donut_state_pick_v3", "value": 1},
              "value": 0.45
            }
          }
        }
      ]
    },
    {
      "title": "Sector Loss Breakdown",
      "data": {"url": "/FIT2179-Assignment-2/data/flood_impacts_long.csv"},
      "width": 340,
      "height": 430,
      "transform": [
        {
          "filter": {"param": "donut_state_pick_v3"}
        },
        {
          "calculate": "toNumber(datum.amount_losses) / 1000000",
          "as": "amount_millions"
        },
        {
          "calculate": "toString(datum.year)",
          "as": "year_str"
        },
        {
          "filter": "breakdown_year_filter == 'Both' || datum.year_str == breakdown_year_filter"
        },
        {
          "calculate": "length(data('donut_state_pick_v3_store')) == 0 ? 'Malaysia' : datum.state",
          "as": "display_area"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "amount_millions",
              "as": "sector_loss_millions"
            }
          ],
          "groupby": ["display_area", "category"]
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "sector_loss_millions",
              "as": "total_loss_millions"
            }
          ],
          "groupby": ["display_area"]
        },
        {
          "calculate": "datum.sector_loss_millions / datum.total_loss_millions",
          "as": "sector_percent"
        },
        {
          "calculate": "datum.category == 'Living Quarters' ? 1 : datum.category == 'Vehicles' ? 2 : datum.category == 'Business' ? 3 : datum.category == 'Manufacturing' ? 4 : datum.category == 'Agriculture' ? 5 : 6",
          "as": "category_order"
        },
        {
          "filter": "datum.sector_loss_millions > 0"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "arc",
            "innerRadius": 72,
            "outerRadius": 150,
            "stroke": "white",
            "strokeWidth": 0.8
          },
          "encoding": {
            "theta": {
              "field": "sector_loss_millions",
              "type": "quantitative",
              "stack": true
            },
            "order": {
              "field": "category_order",
              "type": "quantitative"
            },
            "color": {
              "field": "category",
              "type": "nominal",
              "title": "Sector",
              "legend": {
                "orient": "right",
                "labelLimit": 180,
                "titleLimit": 180
              },
              "scale": {
                "domain": [
                  "Living Quarters",
                  "Vehicles",
                  "Business",
                  "Manufacturing",
                  "Agriculture",
                  "Infrastructure"
                ],
               "range": [
                "#F4A261", 
                "#E76F51",  
                "#E9C46A",  
                "#8D6E63",  
                "#8AB17D",  
                "#6C757D"   
              ]
              }
            },
            "tooltip": [
              {"field": "display_area", "type": "nominal", "title": "Area"},
              {"field": "category", "type": "nominal", "title": "Sector"},
              {
                "field": "sector_loss_millions",
                "type": "quantitative",
                "title": "Loss (RM M)",
                "format": ".2f"
              },
              {
                "field": "sector_percent",
                "type": "quantitative",
                "title": "Share of Total Loss",
                "format": ".0%"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "calculate": "datum.sector_percent >= 0.06 ? format(datum.sector_percent, '.0%') : ''",
              "as": "slice_percent_label"
            }
          ],
          "mark": {
            "type": "text",
            "radius": 118,
            "align": "center",
            "baseline": "middle",
            "fontSize": 16,
            "fontWeight": "bold",
            "color": "white"
          },
          "encoding": {
            "theta": {
              "field": "sector_loss_millions",
              "type": "quantitative",
              "stack": true
            },
            "order": {
              "field": "category_order",
              "type": "quantitative"
            },
            "text": {"field": "slice_percent_label", "type": "nominal"},
            "detail": {"field": "category", "type": "nominal"}
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "sector_loss_millions",
                  "as": "label_total_millions"
                }
              ],
              "groupby": ["display_area"]
            },
            {
              "calculate": "datum.display_area + '\\nRM ' + format(datum.label_total_millions, '.0f') + '\\nmillion'",
              "as": "center_label"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "middle",
            "dy": -10,
            "fontSize": 14,
            "fontWeight": "bold",
            "color": "#374151",
            "lineBreak": "\n"
          },
          "encoding": {
            "text": {"field": "center_label", "type": "nominal"}
          }
        }
      ]
    }
  ],
  "spacing": 10,
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },

    "axisX": {
      "grid": true,
      "gridColor": "#e2e8f0",
      "gridOpacity": 0.7,
      "domain": true,
      "domainColor": "#cbd5e1",
      "tickColor": "#cbd5e1"
    },

    "axisY": {
      "grid": false,
      "domain": false,
      "ticks": false,
      "labelPadding": 2,
      "titlePadding": 0
    },
  "padding": {"top": 8, "bottom": 8, "left": 8, "right": 8},
    "title": {
      "offset": 15,
      "fontSize": 20,
      "subtitleFontSize": 14,
      "anchor": "middle"
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 15
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 15
    }
  }
}

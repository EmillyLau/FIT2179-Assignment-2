{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "When Do Floods Strike? Monthly Flood Frequency by State (2011-2025)",
    "subtitle": "Recorded flood events cluster around the monsoon months, especially along the peninsula's east coast.",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "anchor": "middle"
  },
  "width": 760,
  "height": 520,
  "padding": {"top": 8, "bottom": 8, "left": 8, "right": 8},
  "params": [
    {
      "name": "heatmap_frequency_pick",
      "select": {"type": "point", "fields": ["flood_count"]},
      "bind": "legend"
    }
  ],
  "data": {"url": "data/flood_emdat_state.csv"},
  "transform": [
    {
      "aggregate": [
        {"op": "count", "field": "disaster_no", "as": "flood_count"}
      ],
      "groupby": ["state", "start_month"]
    },
    {
      "calculate": "{'1':'Jan','2':'Feb','3':'Mar','4':'Apr','5':'May','6':'Jun','7':'Jul','8':'Aug','9':'Sep','10':'Oct','11':'Nov','12':'Dec'}[toString(datum.start_month)]",
      "as": "month_name"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 0.8
  },
  "encoding": {
    "x": {
      "field": "month_name",
      "type": "ordinal",
      "title": "Month",
      "scale": {
        "domain": ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
      },
      "axis": {
        "labelAngle": 0,
        "grid": false
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Kelantan",
          "Terengganu",
          "Pahang",
          "Johor",
          "Negeri Sembilan",
          "Melaka",
          "Selangor",
          "Kuala Lumpur",
          "Perak",
          "Penang",
          "Kedah",
          "Perlis",
          "Sabah",
          "Sarawak"
        ]
      },
      "axis": {
        "grid": false,
        "labelPadding": 2
      }
    },
    "color": {
      "field": "flood_count",
      "type": "ordinal",
      "title": "No. of Flood Events",
      "scale": {
        "domain": [1, 2, 3, 4, 5, 6, 8, 9],
        "range": ["#cffafe", "#a5f3fc", "#67e8f9", "#22d3ee", "#0891b2", "#0e7490", "#155e75", "#164e63"]
      },
      "legend": {
        "format": "d",
        "direction": "vertical",
        "titleLimit": 220,
        "labelLimit": 180,
        "symbolLimit": 180
      }
    },
    "opacity": {
      "condition": {"param": "heatmap_frequency_pick", "value": 1},
      "value": 0.25
    },
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State"},
      {"field": "month_name", "type": "nominal", "title": "Month"},
      {"field": "flood_count", "type": "quantitative", "title": "Flood Events"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "title": {
      "offset": 15,
      "fontSize": 17,
      "subtitleFontSize": 12,
      "anchor": "middle"
    }
  }
}
